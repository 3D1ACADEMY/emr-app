{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": [
    "src/features/dangerZone/**/*.ts",
    "src/features/dangerZone/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
